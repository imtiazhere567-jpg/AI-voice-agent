# Copy this file to ".env" and paste your real keys there.
# Never share .env or paste keys into chat.

# Bland AI (bland.ai -> Dashboard -> API Keys)
BLAND_API_KEY=

# Public URL of this server, so Bland can call our tools during a call
# (later: your hosting URL)
PUBLIC_BASE_URL=

# Safety switch. true = no real calls/texts/bookings, actions are only logged.
GLOBAL_TEST_MODE=true

# Database (live). Postgres connection string, e.g. from Neon (Vercel -> Storage -> Neon).
# Leave empty to save to local files in data/ (fine for testing on your computer).
DATABASE_URL=
